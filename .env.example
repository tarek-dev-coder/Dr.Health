# ---------------------------------------------------------------------------
# Dr.Health server configuration
# Copy this file to .env and adjust only if needed. NEVER commit .env.
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development
PORT=3000

# --- OVHcloud AI Endpoints (primary for health questions) -------------------
# Anonymous tier. The placeholder is stripped before the request, so no
# Authorization header is sent.
OVH_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
OVH_MODEL=Meta-Llama-3_3-70B-Instruct
OVH_API_KEY=empty-if-anonymous
OVH_TIMEOUT_MS=40000
OVH_RPM=2

# --- LLM7.io (primary for code, fallback for health) ------------------------
# Anonymous tier. Use "unused" or any non-empty placeholder. A free token from
# https://dash.llm7.io raises the limit to 60 requests/min and 250/hour.
LLM7_BASE_URL=https://api.llm7.io/v1
LLM7_MODEL=codestral-latest
LLM7_API_KEY=unused
LLM7_TIMEOUT_MS=20000
LLM7_RPM=25
LLM7_RETRY_DELAY_MS=2000
LLM7_MAX_RETRIES=2

# --- Chat limits ------------------------------------------------------------
CHAT_TIMEOUT_MS=60000
CHAT_MAX_OUTPUT_TOKENS=800
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_MAX_HISTORY_TURNS=12
CHAT_MAX_HISTORY_CHARS=48000
CHAT_MAX_RESPONSE_CHARS=12000
CHAT_MAX_FILE_MB=0.25
CHAT_MAX_FILE_CHARS=24000
CHAT_MAX_CONCURRENT=3
CHAT_RATE_LIMIT=30
CHAT_RATE_WINDOW_MINUTES=1

# --- Network / origin policy ------------------------------------------------
# Comma-separated exact origins allowed to call the API in addition to
# same-origin requests, e.g. https://app.example.com
ALLOWED_ORIGINS=
# Comma-separated hostnames accepted in the Host header, e.g.
# drhealth.example.com,www.drhealth.example.com
# Required in production when ENFORCE_HTTPS is enabled (the default).
ALLOWED_HOSTS=
# Number of reverse-proxy hops to trust (0/false = none, 1 = one proxy).
TRUST_PROXY=0
# Redirect plain HTTP to HTTPS. Defaults to true in production (and requires
# ALLOWED_HOSTS). Leave empty to use the default; set false only for local
# production testing.
ENFORCE_HTTPS=

# --- API rate limits --------------------------------------------------------
GLOBAL_RATE_LIMIT=300
GLOBAL_RATE_WINDOW_MINUTES=15

# --- Logging ----------------------------------------------------------------
# error | warn | info | debug. Message bodies, files, and provider keys are
# never logged.
LOG_LEVEL=info
