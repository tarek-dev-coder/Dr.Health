# ---------------------------------------------------------------------------
# Dr.Health server configuration
# Copy this file to .env and fill in your own values. NEVER commit .env.
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development
PORT=3000

# --- Public origin and OpenRouter sign-in ---------------------------------
# The public origin of this app. Production must use HTTPS.
APP_ORIGIN=http://localhost:3000
# Optional exact callback override. Defaults to APP_ORIGIN/auth/callback.
OPENROUTER_CALLBACK_URL=
# Free multimodal models. The user's own OpenRouter key is created during
# sign-in; no owner API key is stored in this file.
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-super-vl:free
OPENROUTER_TIMEOUT_MS=60000
OPENROUTER_KEY_LABEL=Dr.Health

# --- Guest mode (optional, text-only) -------------------------------------
# Enabled by default. Guest mode never uses an OpenRouter user key and cannot
# accept images. The default endpoint is keyless.
GUEST_MODE_ENABLED=true
GUEST_API_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1/chat/completions
GUEST_MODEL=Meta-Llama-3_3-70B-Instruct
# Optional server-side token. To use LLM7, set:
#   GUEST_API_URL=https://api.llm7.io/v1/chat/completions
#   GUEST_MODEL=<LLM7 free model id>
#   GUEST_API_KEY=<LLM7 free token>
GUEST_API_KEY=
GUEST_TIMEOUT_MS=45000
GUEST_MAX_OUTPUT_TOKENS=500
GUEST_MAX_MESSAGE_CHARS=2000
GUEST_MAX_HISTORY_TURNS=4
GUEST_MAX_HISTORY_CHARS=4000
GUEST_MAX_RESPONSE_CHARS=6000
GUEST_DAILY_LIMIT=5
GUEST_IP_DAILY_LIMIT=10
GUEST_GLOBAL_DAILY_LIMIT=200
GUEST_RATE_LIMIT=5
GUEST_RATE_WINDOW_MINUTES=10
GUEST_MAX_CONCURRENT=2
GUEST_SESSION_TTL_MINUTES=1440

# --- Database -------------------------------------------------------------
# Required in production. Use a free Neon/Postgres connection string.
# Encrypted per-user keys are stored here; the server never stores plaintext.
DATABASE_URL=
# auto | true | false. Auto uses TLS in production.
DATABASE_SSL=auto
# Connection pool size. Keep this at 1 on Vercel/serverless; Supabase's
# transaction pooler is shared across function instances.
DATABASE_POOL_MAX=5

# --- Secrets --------------------------------------------------------------
# Generate a random secret (at least 32 chars), for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Optional separate key-encryption secret. Falls back to SESSION_SECRET.
# Rotating this value makes existing saved user keys unreadable.
KEY_ENCRYPTION_SECRET=
USER_SESSION_TTL_MINUTES=10080

# --- Admin API (optional) -------------------------------------------------
# Generate the hash (never store the plain password):
#   npm run hash-password
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_MINUTES=120

# --- Network / origin policy ---------------------------------------------
# Comma-separated exact origins allowed to call the API in addition to
# same-origin requests, e.g. https://app.example.com
ALLOWED_ORIGINS=
# Comma-separated hostnames accepted in the Host header, e.g.
# drhealth.example.com,www.drhealth.example.com
# Required in production when ENFORCE_HTTPS is enabled (the default).
ALLOWED_HOSTS=
# Number of reverse-proxy hops to trust (0/false = none, 1 = one proxy).
TRUST_PROXY=0
# Redirect plain HTTP to HTTPS. Defaults to true in production (and requires
# ALLOWED_HOSTS). Leave empty to use the default; set false only for local
# production testing.
ENFORCE_HTTPS=

# --- Limits ---------------------------------------------------------------
MAX_UPLOAD_MB=5
MAX_MESSAGE_CHARS=4000
MAX_HISTORY_TURNS=20
MAX_HISTORY_CHARS=20000
GLOBAL_RATE_LIMIT=300
GLOBAL_RATE_WINDOW_MINUTES=15
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_MINUTES=10
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MINUTES=15
AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW_MINUTES=15

# --- Logging --------------------------------------------------------------
# error | warn | info | debug. Request bodies and health content are never logged.
LOG_LEVEL=info
